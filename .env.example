# Copy to .env — never commit .env (the repo is public).
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Check exact model IDs on day 1 with client.models.list()
MODEL_PLANNER=muse-spark-1.3
MODEL_EAR2=muse-spark-1.2
MODEL_VISION=muse-spark-1.3
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0

# api | open | mock — leave empty to auto-detect from MODEL_API_KEY
KAHIE_BACKEND=

# Config D — open weights through a partner (OpenAI-compatible endpoint)
OPEN_WEIGHTS_BASE=
OPEN_WEIGHTS_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026

# Evaluation switches
KAHIE_EAR2=on
KAHIE_LEXICON=on
# Ear 1: voice_transcribe (default) | spark_literal | whisper | off
EAR1_MODE=voice_transcribe
# Voice Transcribe language bias: empty = auto-detect; or French
VT_LANGUAGE_BIAS=
# FIREWORKS_API_KEY=...   # needed only if EAR1_MODE=whisper

# Optional server voice (Google Gemini TTS). Empty = the phone's own voice reads Kahie's replies.
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Aoede
