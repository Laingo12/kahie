# Copy to .env — never commit .env (the repo is public).
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Check exact model IDs on day 1 with client.models.list()
MODEL_PLANNER=muse-spark-1.3
MODEL_EAR2=muse-spark-1.3
MODEL_VISION=muse-spark-1.3
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0

# api | open | mock (mock = offline rules, used automatically when no key is set)
KAHIE_BACKEND=

# Config D — open weights through a partner (OpenAI-compatible endpoint)
OPEN_WEIGHTS_BASE=
OPEN_WEIGHTS_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026

# Evaluation switches
KAHIE_EAR2=on
KAHIE_LEXICON=on
# Ear 1: spark_literal (default) | whisper | voice_transcribe | off
EAR1_MODE=spark_literal
# FIREWORKS_API_KEY=...   # needed only if EAR1_MODE=whisper